//
//  Secrets.swift.example
//  injecy
//
//  Copy this file to `Secrets.swift` (same folder) and fill in your values.
//  `Secrets.swift` is git-ignored, so real secrets never land in version control.
//
//      cp Secrets.swift.example Secrets.swift
//

enum InjecySecrets {
	/// Must match your backend's INJECY_CLIENT_SECRET (used in the X-Injecy-Secret
	/// header on /register). The reference backend is closed-source — point
	/// `InjecyBackend.base` at your own server and set this to its client secret.
	static let buildSecret = "REPLACE_WITH_YOUR_BACKEND_CLIENT_SECRET"
}
